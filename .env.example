# 数据库连接字符串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instrument_site?schema=public"

# Session 密钥（生产环境必须修改为随机长字符串）
SESSION_SECRET="your-secret-key-here"

# 初始管理员账号（仅 seed 时使用，首次登录后请修改密码）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123456"
ADMIN_DISPLAY_NAME="运营管理员"

# 站点 URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 邮件 SMTP 配置（可选，用于询价邮件通知）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
